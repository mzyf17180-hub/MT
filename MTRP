<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة MTRP الشامل</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Tahoma, sans-serif; }
        body { background-color: #0b0b0e; color: #fff; min-height: 100vh; }
        
        /* شاشة تسجيل الدخول */
        #loginScreen { display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .login-card { background: #141419; border: 1px solid #2d2d3d; border-radius: 12px; width: 100%; max-width: 420px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); text-align: center; }
        .logo { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; margin-bottom: 15px; border: 2px solid #ff7b00; }
        h2 { color: #ff7b00; margin-bottom: 5px; font-size: 22px; }
        .subtitle { color: #8c8c9e; font-size: 13px; margin-bottom: 25px; }
        .form-group { text-align: right; margin-bottom: 15px; }
        label { display: block; font-size: 13px; color: #b4b4c7; margin-bottom: 5px; }
        input, textarea { width: 100%; padding: 12px; background: #1c1c24; border: 1px solid #333347; border-radius: 8px; color: #fff; font-size: 14px; outline: none; transition: 0.3s; }
        input:focus, textarea:focus { border-color: #ff7b00; box-shadow: 0 0 8px rgba(255,123,0,0.3); }
        .btn-discord { background: #5865F2; color: #fff; border: none; width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; gap: 8px; transition: 0.3s; }
        .btn-discord:hover { background: #4752c4; }
        .btn-submit { background: linear-gradient(135deg, #ff7b00, #7b2cbf); color: #fff; border: none; width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s; }
        .btn-submit:hover { opacity: 0.9; }
        .footer-warning { margin-top: 20px; font-size: 10px; color: #555568; background: #0f0f14; padding: 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; }

        /* لوحة التحكم (مخفية حتى يتم تسجيل الدخول) */
        #appScreen { display: none; height: 100vh; overflow: hidden; display: flex; }
        .sidebar { width: 260px; background: #141419; border-left: 1px solid #2d2d3d; display: flex; flex-direction: column; padding: 20px; }
        .sidebar h3 { color: #ff7b00; margin-bottom: 20px; font-size: 18px; text-align: center; }
        .sidebar button { background: transparent; border: none; color: #b4b4c7; padding: 12px; text-align: right; width: 100%; border-radius: 8px; cursor: pointer; margin-bottom: 8px; transition: 0.3s; font-size: 14px; }
        .sidebar button:hover, .sidebar button.active { background: linear-gradient(135deg, rgba(255,123,0,0.2), rgba(123,44,191,0.2)); color: #ff7b00; border-right: 3px solid #ff7b00; }
        
        .main-content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; }
        header { background: #141419; padding: 15px 30px; border-bottom: 1px solid #2d2d3d; display: flex; justify-content: space-between; align-items: center; }
        .user-info { display: flex; align-items: center; gap: 10px; }
        .user-info img { width: 40px; height: 40px; border-radius: 50%; border: 1px solid #7b2cbf; }
        
        .content-body { padding: 30px; }
        .panel-section { display: none; }
        .panel-section.active { display: block; }
        
        .form-box { background: #141419; border: 1px solid #2d2d3d; padding: 25px; border-radius: 10px; max-width: 600px; }
        .form-box h3 { color: #7b2cbf; margin-bottom: 15px; }
        .input-group { margin-bottom: 15px; text-align: right; }
        .input-group label { display: block; color: #ff7b00; font-size: 13px; margin-bottom: 5px; }
        .btn-send { background: linear-gradient(135deg, #ff7b00, #7b2cbf); color: #fff; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; width: 100%; }
        .btn-logout { background: #d9534f; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
    </style>
</head>
<body>

    <!-- 1️⃣ واجهة تسجيل الدخول -->
    <div id="loginScreen">
        <div class="login-card">
            <h2>نظام إدارة MTRP</h2>
            <p class="subtitle">مرحباً بك، يرجى تسجيل الدخول للمتابعة</p>

            <button type="button" class="btn-discord" onclick="verifyDiscord()">
                🔒 1 - تحقق الديسكورد (إلزامي)
            </button>

            <form id="loginForm" onsubmit="handleLogin(event)">
                <div class="form-group">
                    <label>رتبتك / اليونت (مثال: HC-1)</label>
                    <input type="text" id="unitInput" placeholder="0-0 / HC-1 / AG-1" required>
                </div>
                <div class="form-group">
                    <label>رمز الدخول (الخاص بك)</label>
                    <input type="password" id="passInput" placeholder="أدخل كلمة المرور" required>
                </div>
                <div class="form-group">
                    <label>اسم حساب Roblox</label>
                    <input type="text" id="robloxInput" placeholder="RobloxUsername" required>
                </div>
                <button type="submit" class="btn-submit">تسجيل الدخول الآمن</button>
            </form>
            <div class="footer-warning">Unauthorized Access is a Federal Offense</div>
        </div>
    </div>

    <!-- 2️⃣ لوحة التحكم الرئيسية -->
    <div id="appScreen" style="display: none;">
        <div class="sidebar">
            <h3>نظام MTRP</h3>
            <button class="active" onclick="switchTab(event, 'complaints')">📋 نظام الشكاوي</button>
            <button onclick="switchTab(event, 'suggestions')">💡 المقترحات</button>
            <button onclick="switchTab(event, 'owners')">🔒 قائمة الأونرز</button>
        </div>

        <div class="main-content">
            <header>
                <h2>مرحباً بك في نظام إدارة MTRP</h2>
                <div class="user-info">
                    <span id="userNameDisplay">الإداري</span>
                    <img src="https://via.placeholder.com/40" alt="Avatar">
                    <button class="btn-logout" onclick="logout()">تسجيل خروج</button>
                </div>
            </header>

            <div class="content-body">
                <!-- قسم الشكاوي -->
                <div id="complaints" class="panel-section active">
                    <div class="form-box">
                        <h3>نموذج تقديم شكوى</h3>
                        <form onsubmit="submitComplaint(event)">
                            <div class="input-group">
                                <label>1 - اسم المشتكي</label>
                                <input type="text" id="c1" placeholder="اكتب اسمك هنا..." required>
                            </div>
                            <div class="input-group">
                                <label>2 - اسم المشتكا عليه</label>
                                <input type="text" id="c2" placeholder="اكتب اسم الشخص..." required>
                            </div>
                            <div class="input-group">
                                <label>3 - سبب الشكوى</label>
                                <textarea id="c3" rows="3" placeholder="اشرح السبب بالتفصيل..." required></textarea>
                            </div>
                            <div class="input-group">
                                <label>4 - هل لديك دليل؟ (أرفق الرابط)</label>
                                <input type="text" id="c4" placeholder="رابط الدليل (صورة/فيديو)" required>
                            </div>
                            <button type="submit" class="btn-send">إرسال الشكوى</button>
                        </form>
                    </div>
                </div>

                <!-- قسم المقترحات -->
                <div id="suggestions" class="panel-section">
                    <div class="form-box">
                        <h3>تقديم اقتراح لتطوير السيرفر</h3>
                        <form onsubmit="alert('تم إرسال اقتراحك للإدارة بنجاح!'); event.target.reset();">
                            <div class="input-group">
                                <label>ما هو اقتراحك؟</label>
                                <textarea rows="4" placeholder="اكتب اقتراحك هنا..." required></textarea>
                            </div>
                            <button type="submit" class="btn-send">إرسال الاقتراح</button>
                        </form>
                    </div>
                </div>

                <!-- قسم الأونرز -->
                <div id="owners" class="panel-section">
                    <div class="form-box">
                        <h3>لوحة تحكم الأونرز (محمية)</h3>
                        <div class="input-group">
                            <label>كلمة سر الأونرز الخاصة</label>
                            <input type="password" id="ownerPass" placeholder="أدخل كلمة المرور السرية...">
                        </div>
                        <button type="button" class="btn-send" onclick="checkOwner()">دخول اللوحة السرية</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // التحقق التلقائي من الجلسة عند فتح الملف
        window.onload = function() {
            const savedUser = localStorage.getItem("mtrp_logged_user");
            if (savedUser) {
                const data = JSON.parse(savedUser);
                document.getElementById("userNameDisplay").innerText = "يوزر: " + data.roblox;
                document.getElementById("loginScreen").style.display = "none";
                document.getElementById("appScreen").style.display = "flex";
            }
        }

        function verifyDiscord() {
            alert("تم توجيهك! يرجى الذهاب للديسكورد وكتابة الأمر !verify للبوت في سيرفرنا عشان يجيك رمز التحقق على الخاص.");
            // ملاحظة: إذا تبي تخليه يفتح سيرفر الديسكورد مباشرة فك السطر اللي تحت وحط رابط سيرفرك
            // window.open('https://discord.gg/رابط_سيرفرك', '_blank');
        }

        function handleLogin(event) {
            event.preventDefault();
            const unit = document.getElementById("unitInput").value;
            const roblox = document.getElementById("robloxInput").value;

            // حفظ الجلسة محلياً عشان ما ينطرد ويحفظ دخوله تلقائياً
            localStorage.setItem("mtrp_logged_user", JSON.stringify({ unit, roblox, time: Date.now() }));
            
            document.getElementById("userNameDisplay").innerText = "يوزر: " + roblox;
            document.getElementById("loginScreen").style.display = "none";
            document.getElementById("appScreen").style.display = "flex";
        }

        function switchTab(evt, tabName) {
            let sections = document.querySelectorAll('.panel-section');
            sections.forEach(s => s.classList.remove('active'));
            let buttons = document.querySelectorAll('.sidebar button');
            buttons.forEach(b => b.classList.remove('active'));
            
            document.getElementById(tabName).classList.add('active');
            evt.currentTarget.classList.add('active');
        }

        function submitComplaint(event) {
            event.preventDefault();
            alert("تم إرسال الشكوى بنجاح وسيتم معالجتها وإرسالها للنظام تلقائياً!");
            event.target.reset();
        }

        function checkOwner() {
            const pass = document.getElementById("ownerPass").value;
            if(pass === "MTRP11") { // كلمة السر الجديدة للأونرز
                alert("تم التحقق بنجاح! أهلاً بك يا أونر.");
            } else {
                alert("كلمة المرور غير صحيحة!");
            }
        }

        function logout() {
            localStorage.removeItem("mtrp_logged_user");
            location.reload();
        }
    </script>
</body>
</html>
